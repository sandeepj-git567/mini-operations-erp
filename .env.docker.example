# ==============================================================================
# Docker Compose Environment Template (.env.docker.example)
# Copy to .env.docker to configure container environment variables for Supabase
# ==============================================================================

# Backend Environment Variables (Server-Only)
PORT=5000
NODE_ENV=production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"

# Frontend Environment Variables (Client-Exposed)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
